<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- API Configuration -->
    <add key="ApiBaseUrl" value="https://www.samuelezranas.codes/api"/>
    <add key="WebsiteUrl" value="https://www.samuelezranas.codes"/>
    <add key="AdminWebUrl" value="https://www.samuelezranas.codes/admin"/>

    <!-- Application Configuration -->
    <add key="AppName" value="Website Admin Panel"/>
    <add key="AppVersion" value="1.0.0"/>

    <!-- Theme Configuration -->
    <add key="ThemeName" value="Dark Purple"/>
    <add key="PrimaryColor" value="#190C23"/>
    <add key="AccentColor" value="#9650B6"/>
    <add key="TextColor" value="#FFFFFF"/>

    <!-- Feature Flags -->
    <add key="EnableOfflineMode" value="true"/>
    <add key="EnableAutoSync" value="true"/>
    <add key="SyncIntervalSeconds" value="300"/>

    <!-- Data Storage -->
    <add key="StorageFolder" value="AdminPanel"/>
    <add key="BackupEnabled" value="true"/>
    <add key="BackupInterval" value="7"/>
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
